# Скопируйте этот файл в .env и заполните значения.
# .env никогда не должен попадать в git / GitHub.

# Ключ DeepSeek API — без него ИИ работает в офлайн-режиме (без поиска мероприятий).
# Получить ключ: https://platform.deepseek.com/api_keys
# ВАЖНО: никогда не публикуйте реальный ключ в коде, чате или репозитории —
# он должен существовать только здесь, в .env на сервере.
DEEPSEEK_API_KEY=

# Любая случайная длинная строка для подписи JWT-токенов авторизации.
JWT_SECRET=change-me-to-a-long-random-string

# Порт, на котором запускается сервер.
PORT=4000
